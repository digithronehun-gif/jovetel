# JóVétel — környezeti változók (ARCHITECTURE.md 10. pont)
# Másold .env.local-ba, és töltsd ki. A .env* fájlokat a Claude Code nem olvashatja;
# hogy mi van beállítva, azt a `pnpm env:check` mutatja meg (csak igen/nem).
# Ami üres, ott az app helyi megoldással vagy fixture-rel dolgozik.

# Alap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development                 # development | preview | production (a Vercelen a VERCEL_ENV is számít)
LAUNCH_MODE=waitlist                 # waitlist | live
BETA_ALLOWLIST=                      # vesszővel elválasztott e-mailek (waitlist módban)
ALLOW_DEV_IMAGES=true                # production-ben tudatos döntés; lásd 7. vasszabály

# Supabase (helyi fejlesztésben: `pnpm local:up` vagy `supabase start` — ugyanezek az értékek)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # csak szerver/script
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres        # pooler (6543) élesben, prepare:false
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres # migrációkhoz (5432)
INGEST_DATABASE_URL=                 # az ingest scriptnek: a Supabase pooler SESSION módja (5432); üresen a DIRECT_DATABASE_URL
FEED_RAW_STORE=                      # supabase | local (alapértelmezés: production-ben supabase)

# AI
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_INTERPRET=claude-haiku-4-5
AI_MODEL_EXPLAIN=claude-haiku-4-5
AI_MAX_COST_HUF_PER_REQUEST=1.5
AI_DAILY_BUDGET_HUF=2000

# E-mail
RESEND_API_KEY=
EMAIL_FROM="JóVétel <hello@example.hu>"
UNSUBSCRIBE_SECRET=
ADMIN_ALERT_EMAIL=                   # ide mennek a riasztások (feed blokkolva, AI-költség stb.)

# Védelem, mérés
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
CRON_SECRET=
INGEST_DISPATCH_TOKEN=               # az admin [Futtatás most] gombjához: GitHub token (Actions: read/write, csak ez a repó)
INGEST_DISPATCH_REPO=                # tulajdonos/repo
INGEST_DISPATCH_REF=main
IP_HASH_SALT=

# Affiliate hálózatok (amelyik még nincs, maradjon üresen → fixture mód)
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=
CJ_API_TOKEN=
CJ_WEBSITE_ID=
DOGNET_API_KEY=
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=

# Seed
SEED_ADMIN_EMAIL=
