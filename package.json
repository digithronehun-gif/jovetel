{
  "name": "jovetel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JóVétel — személyes vásárlási társ, ami emlékszik rád.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-assets.ts --enforce && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "tsx scripts/db/new-migration.ts",
    "db:migrate": "tsx scripts/db/migrate.ts up",
    "db:rollback": "tsx scripts/db/migrate.ts down",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "ingest": "tsx scripts/ingest.ts",
    "sync:conversions": "tsx scripts/sync-conversions.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "eval:ai": "tsx scripts/eval-ai.ts",
    "email:dev": "email dev --dir emails --port 3030",
    "env:check": "tsx scripts/env-check.ts",
    "local:up": "bash scripts/local-stack/up.sh",
    "local:down": "bash scripts/local-stack/down.sh",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.1",
    "next": "16.3.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
